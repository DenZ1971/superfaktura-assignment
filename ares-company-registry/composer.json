{
    "name": "denz1971/ares-company-registry",
    "description": "A PHP library for retrieving company data from the Czech ARES registry",
    "type": "library",
    "license": "proprietary",

    "require": {
        "php": "^8.3",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "analyse": "phpstan analyse"
    },
    "autoload": {
        "psr-4": {
            "Den\\AresCompanyRegistry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Den\\AresCompanyRegistry\\Tests\\": "tests/"
        }
    }
}
